# Freebird Collab relay settings -> copy to /etc/freebird-relay.env, then
#   sudo systemctl restart freebird-relay
# 0 = unlimited / off.  Defaults are written out; delete a line to use the default.
# (Docker: docker-compose.yml reads the same file.)

# whole server
FREEBIRD_MAX_CONNECTIONS=200
FREEBIRD_MAX_ROOMS=100

# per connection (a client over a limit gets "relay limit: ..." in Blender and is disconnected;
# the rest of its room keeps working).  A "batch" message counts as 1.
FREEBIRD_MAX_MSGS_PER_MIN=6000
FREEBIRD_MAX_MB_PER_MIN=512
FREEBIRD_MAX_MESSAGE_MB=4

# seconds
FREEBIRD_HELLO_TIMEOUT=20
FREEBIRD_IDLE_TIMEOUT=300

# one "[stats] sockets=.. rooms=.. frames/min=.." line in the log every N seconds (0 = off)
FREEBIRD_STATS_INTERVAL=60
# 1 = https://<domain>/stats answers {"sockets":N,"rooms":M,...} like the Cloudflare relay
FREEBIRD_STATS_ENDPOINT=1
